{
  "name": "Booking",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Guest name"
    },
    "email": {
      "type": "string",
      "description": "Guest email"
    },
    "phone": {
      "type": "string",
      "description": "Guest phone number"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Booking date"
    },
    "time": {
      "type": "string",
      "description": "Arrival time e.g. 19:00"
    },
    "party_size": {
      "type": "integer",
      "description": "Number of guests"
    },
    "table_preference": {
      "type": "string",
      "description": "Preferred area or table e.g. First Floor, Second Floor"
    },
    "occasion": {
      "type": "string",
      "enum": [
        "none",
        "birthday",
        "anniversary",
        "work event",
        "date night",
        "other"
      ],
      "default": "none",
      "description": "Special occasion"
    },
    "dietary_notes": {
      "type": "string",
      "description": "Dietary requirements or allergen notes"
    },
    "special_requests": {
      "type": "string",
      "description": "Any other special requests"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "arrived",
        "no_show",
        "cancelled"
      ],
      "default": "confirmed",
      "description": "Booking status"
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether a deposit has been paid"
    },
    "notes": {
      "type": "string",
      "description": "Internal staff notes"
    },
    "marketing_email": {
      "type": "boolean",
      "default": false,
      "description": "Customer consented to email marketing"
    },
    "marketing_sms": {
      "type": "boolean",
      "default": false,
      "description": "Customer consented to SMS / text marketing"
    },
    "marketing_phone": {
      "type": "boolean",
      "default": false,
      "description": "Customer consented to phone call marketing"
    }
  },
  "required": [
    "name",
    "date",
    "time",
    "party_size"
  ]
}