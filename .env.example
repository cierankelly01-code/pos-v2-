# Copy to .env.local and fill in your Supabase project values.
# Vercel: add the same variables in Project Settings → Environment Variables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Or use the newer publishable key instead of anon key:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets):
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=bookings@yourdomain.com
